 			if (!rsmi_dl_handle) {
 				Logger::info("Failed to load librocm_smi64.so, AMD GPUs will not be detected: {}", dlerror());
 				return false;
 			}
 
+			//? Clear any stale error from the failed dlopen attempts above,
+			//? as musl keeps it until dlerror() is called
+			dlerror();
