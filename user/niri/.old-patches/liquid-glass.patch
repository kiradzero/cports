+// Smooth influence of one edge. Combining all four influences rather than
+// selecting the nearest edge avoids the visible diagonal Voronoi seams of a
+// rounded-rectangle SDF when a wide refractive rim is used.
+float glass_edge_weight(float distance_to_edge, float width) {
+    float x = clamp(1.0 - distance_to_edge / width, 0.0, 1.0);
+    return x * x * (3.0 - 2.0 * x);
+}
+
+void glass_field(vec2 p, float width, out float rim, out vec2 inward) {
+    float left = glass_edge_weight(p.x, width);
+    float right = glass_edge_weight(geo_size.x - p.x, width);
+    float top = glass_edge_weight(p.y, width);
+    float bottom = glass_edge_weight(geo_size.y - p.y, width);
+
+    // Opposing edges cancel continuously when their wide rims overlap. At a
+    // corner two edges blend into a diagonal normal without a hard boundary.
+    vec2 field = vec2(left - right, top - bottom);
+    float magnitude = length(field);
+    rim = min(magnitude, 1.0);
+    inward = magnitude > 0.0001 ? field / magnitude : vec2(0.0);
+}
+
+vec2 glass_texture_coords(vec2 geo_coords, vec2 inward, float displacement) {
+    vec2 displaced_geo = geo_coords + inward * displacement / geo_size;
+    return (geo_to_input * vec3(displaced_geo, 1.0)).xy;
+}
+
+vec4 sample_and_postprocess(vec2 texture_coords, vec2 geo_coords) {
+    float rim;
+    vec2 inward;
+    float width = max(glass_width, 0.0001);
+    glass_field(geo_coords * geo_size, width, rim, inward);
+
+    float displacement = glass_refraction * width * rim;
+
+    vec4 color;
+    if (rim > 0.0001 &&
+        (glass_refraction > 0.0 || glass_chromatic_aberration > 0.0)) {
+        float split = glass_chromatic_aberration * rim;
+        vec2 red_coords = glass_texture_coords(geo_coords, inward, displacement + split);
+        vec2 green_coords = glass_texture_coords(geo_coords, inward, displacement);
+        vec2 blue_coords = glass_texture_coords(
+            geo_coords,
+            inward,
+            max(displacement - split, 0.0)
+        );
+
+        vec4 red = texture2D(tex, red_coords);
+        vec4 green = texture2D(tex, green_coords);
+        vec4 blue = texture2D(tex, blue_coords);
+        color = vec4(red.r, green.g, blue.b, green.a);
+    } else {
+        color = texture2D(tex, texture_coords);
+    }
+
     if (saturation != 1.0) {
