musl has no dladdr1()/RTLD_DL_LINKMAP (glibc extensions). Plain dladdr(),
which musl does provide, already fills Dl_info::dli_fname with the path of
the shared object containing the given symbol -- exactly what rocFFT needs to
locate its kernel cache next to librocfft.so. Use it instead of dladdr1.

--- a/library/src/include/library_path.h
+++ b/library/src/include/library_path.h
@@ -58,13 +58,11 @@
 static std::filesystem::path get_library_path_unix()
 {
     // get address of rocfft lib by looking for a symbol in it
-    Dl_info   info;
-    link_map* map = nullptr;
-    if(!dladdr1(reinterpret_cast<const void*>(rocfft_plan_create),
-                &info,
-                reinterpret_cast<void**>(&map),
-                RTLD_DL_LINKMAP))
-        throw std::runtime_error("dladdr failed");
-    return map->l_name;
+    // musl lacks dladdr1/RTLD_DL_LINKMAP; plain dladdr's dli_fname
+    // already gives the path of the shared object we're in
+    Dl_info info;
+    if(!dladdr(reinterpret_cast<const void*>(rocfft_plan_create), &info))
+        throw std::runtime_error("dladdr failed");
+    return info.dli_fname;
 }
 #endif
