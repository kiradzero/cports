std.http.Client: perform TLS handshake after HTTP CONNECT tunnel

Upstream bug (ziglang/zig#19878, open since 2024): connectProxied() returns
the tunneled connection still tagged with the proxy's protocol (plain), so
HTTPS requests through an http_proxy go out in cleartext and the target
server closes the connection (HttpConnectionClosing) or answers
"400 Bad Request". Fix modeled on the vendored patch in llllOllOOll/pacman;
validated locally against codeberg and github through a CONNECT proxy.

--- a/lib/std/http/Client.zig
+++ b/lib/std/http/Client.zig
@@ -1528,6 +1528,7 @@
     proxy: *Proxy,
     proxied_host: HostName,
     proxied_port: u16,
+    protocol: Protocol,
 ) !*Connection {
     const io = client.io;
     if (!proxy.supports_connect) return error.TunnelNotSupported;
@@ -1535,7 +1536,7 @@
     if (try client.connection_pool.findConnection(io, .{
         .host = proxied_host,
         .port = proxied_port,
-        .protocol = proxy.protocol,
+        .protocol = protocol,
     })) |node| return node;
 
     var maybe_valid = false;
@@ -1580,6 +1581,30 @@
 
         connection.closing = false;
 
+        // The tunnel above was dialed using the proxy's own protocol (plain),
+        // not the real target's. If the target actually requires TLS, the
+        // handshake still needs to happen here - otherwise the caller ends up
+        // sending the HTTP request in cleartext through the tunnel, which the
+        // destination server (expecting TLS on that port) rejects.
+        if (protocol == .tls) {
+            const stream = connection.getStream();
+            const plain: *Connection.Plain = @alignCast(@fieldParentPtr("connection", connection));
+
+            try client.connection_pool.mutex.lock(io);
+            client.connection_pool.used.remove(&connection.pool_node);
+            client.connection_pool.mutex.unlock(io);
+            plain.destroy(); // frees the Plain wrapper only; `stream` stays open
+
+            const tls = Connection.Tls.create(client, proxied_host, proxied_port, stream) catch |err| switch (err) {
+                error.OutOfMemory => |e| return e,
+                error.Unexpected => |e| return e,
+                error.Canceled => |e| return e,
+                else => return error.TlsInitializationFailed,
+            };
+            try client.connection_pool.addUsed(io, &tls.connection);
+            return &tls.connection;
+        }
+
         return connection;
     }) catch {
         // something went wrong with the tunnel
@@ -1614,7 +1639,7 @@
     }
 
     if (proxy.supports_connect) tunnel: {
-        return connectProxied(client, proxy, host, port) catch |err| switch (err) {
+        return connectProxied(client, proxy, host, port, protocol) catch |err| switch (err) {
             error.TunnelNotSupported => break :tunnel,
             else => |e| return e,
         };
