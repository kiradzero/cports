Fix stricter type checking in clang 22: a bool-returning function must
not return NULL, and a uint64_t-returning function must not return NULL.
--- a/runtime/hsa-runtime/core/runtime/hsa.cpp
+++ b/runtime/hsa-runtime/core/runtime/hsa.cpp
@@ -155,7 +155,7 @@
 
 template <class T>
 static __forceinline bool IsValid(T* ptr) {
-  return (ptr == NULL) ? NULL : ptr->IsValid();
+  return (ptr == NULL) ? false : ptr->IsValid();
 }
 
 namespace AMD {
--- a/runtime/hsa-runtime/loader/executable.cpp
+++ b/runtime/hsa-runtime/loader/executable.cpp
@@ -1614,7 +1614,7 @@
 uint64_t ExecutableImpl::SymbolAddress(hsa_agent_t agent, elf::Symbol* sym)
 {
   elf::Section* sec = sym->section();
-  if(!sec) { return NULL; }
+  if(!sec) { return 0; }
   
   Segment* seg = SectionSegment(agent, sec);
   uint64_t vaddr = sec->addr() + sym->value();
