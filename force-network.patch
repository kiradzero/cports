 # whether to attempt using remote repositories (if available)
 remote = yes
+# force network access in all build phases (useful for VPN workarounds)
+# this overrides network isolation in bwrap and allows internet access
+# even in phases where it's normally disabled (build, install, etc.)
+force_network = no
